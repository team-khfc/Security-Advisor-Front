# 모의 API는 개발·시연 전용이며 서버 프로세스 재시작 시 초기화됩니다.
API_MODE=mock
INSTITUTION_NAME=가상 공공기관
INSTITUTION_CODE=DEMO
# 실제 Back 연결: API_MODE=api (브라우저에 노출하지 않는 서버 설정)
API_BASE_URL=http://localhost:8080
# 모의 계정 아이디·비밀번호 로그인이 필요하면 개인 .env.local에서 설정하세요.
# 기본 모의 로그인 카드는 비밀번호를 사용하지 않는 합성 계정 진입점입니다.
DEMO_ACCOUNT_PASSWORD=
