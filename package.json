{
  "name": "security-advisor-front",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.14 <25"
  },
  "scripts": {
    "dev": "node tools/runNext.mjs dev mock",
    "dev:api": "node tools/runNext.mjs dev api",
    "test:server": "node tools/runBackendTestServer.mjs",
    "test:connection": "node tools/checkBackendConnection.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "format": "prettier --write app components features lib mocks styles tests tools *.ts *.mjs *.json .github/workflows/*.yml",
    "format:check": "prettier --check app components features lib mocks styles tests tools *.ts *.mjs *.json .github/workflows/*.yml",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check:docs": "python3 tools/check_doc_versions.py",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run check:docs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "bcryptjs": "3.0.3",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.10.1",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.5",
    "jsdom": "31.0.0",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
